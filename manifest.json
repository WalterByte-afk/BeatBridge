{
  "manifest_version": 3,
  "name": "BeatBridge - AutoMix Engine",
  "version": "1.0.0",
  "description": "Apple-style seamless DJ transitions for YouTube Music",
  "action": {
    "default_popup": "code.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "workers/*"
      ],
      "matches": [
        "*://music.youtube.com/*"
      ]
    }
  ]
}
